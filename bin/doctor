#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
if [ "$#" -ne 0 ]; then
    echo 'Usage: bin/doctor' >&2
    exit 2
fi
if [ ! -x env/bin/python ]; then
    echo 'Missing local env; run bin/setup with an installed Python >=3.7,<3.12.' >&2
    exit 1
fi
# pip check reads package metadata; it does not contact CTM or the keychain.
env/bin/python -m pip check
exec env/bin/python - <<'PY'
import sys
try:
    from importlib.metadata import version, PackageNotFoundError
except ImportError:  # Python 3.7 uses the pinned backport.
    from importlib_metadata import version, PackageNotFoundError
from pathlib import Path
failed = not ((3, 7) <= sys.version_info[:2] < (3, 12))
print('Python: ' + sys.version.split()[0])
for requirement in Path('requirements.txt').read_text().splitlines():
    if not requirement.strip() or requirement.startswith('#'):
        continue
    try:
        name, expected = requirement.split('==', 1)
        if version(name) == expected:
            continue
    except PackageNotFoundError:
        pass
    print('Missing or mismatched dependency: ' + requirement)
    failed = True
print('Dependency diagnostics ' + ('failed' if failed else 'OK'))
sys.exit(1 if failed else 0)
PY
